# Backend — copy to .env and fill in values

# Database (Railway PostgreSQL plugin)
# Railway auto-injects this when you add a Postgres plugin to the same
# project as this backend service. Locally, run a Postgres container or
# point this at your Railway plugin's public connection string.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/boastlib

# JWT Secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# CORS (comma-separated)
CORS_ORIGINS=https://smm-frontend-blue.vercel.app,http://localhost:3000

# Paystack (card payments — your existing account)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
# Optional: set a specific currency only if your Paystack account is enabled for it.
# If unset, we will let Paystack use your account's default merchant currency.
PAYSTACK_CURRENCY=

# PawaPay (mobile money)
PAWAPAY_API_KEY=your_pawapay_api_key
PAWAPAY_BASE_URL=https://api.pawapay.io

# SMM Providers
WIZSMM_API_KEY=your_wizsmm_api_key
WIZSMM_API_URL=https://wizsmm.com/api/v2

# Email (Brevo)
BREVO_API_KEY=your_brevo_api_key
FROM_EMAIL=noreply@boastlib.com
FROM_NAME=BOASTLIB

# Frontend URL
FRONTEND_URL=https://boastlib.vercel.app

# Environment
DEBUG=false
ENVIRONMENT=production

# Dodo Payments (card / global checkout)
DODO_PAYMENTS_API_KEY=your_dodo_api_key_here
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_webhook_secret_here
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Optional Telegram notification for manual payment requests
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
